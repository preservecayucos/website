---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';
import { getUpdates, formatDate } from '../../lib/updates';

export async function getStaticPaths() {
  const posts = await getUpdates();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.summary}>
  <article class="section">
    <div class="wrap narrow">
      <a href="/updates/" class="back">← All updates</a>
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
      <h1>{post.data.title}</h1>
      {post.data.image && <img class="hero-img" src={post.data.image} alt={post.data.image_alt ?? ''} />}
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
  <Signup />
</Base>

<style>
  .narrow { max-width: calc(var(--narrow) + 2.5rem); }
  .back { display: inline-block; font-weight: 600; font-size: 0.92rem; margin-bottom: 2rem; text-decoration: none; }
  time { display: block; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.5rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 1.5rem; }
  .hero-img { border-radius: var(--radius); margin-bottom: 2rem; width: 100%; }
</style>
