---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you">
  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">Thank you</p>
      <h1 id="thanks-title">Got it. Thank you.</h1>
      <p id="thanks-text" class="intro">We'll be in touch.</p>
      <a href="/" class="btn btn-ghost">Back to home</a>
    </div>
  </section>
</Base>

<script>
  const f = new URLSearchParams(location.search).get('f');
  const text = document.getElementById('thanks-text');
  if (text && f === 'newsletter') text.textContent = "You're on the list. We'll send news when there's something worth knowing.";
  if (text && f === 'contact') text.textContent = 'Your message is on its way. Someone from Preserve Cayucos will get back to you.';
</script>

<style>
  .intro { font-size: 1.2rem; color: var(--muted); margin-bottom: 2rem; }
</style>
