---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const c = site.contact;
---
<Base title="Contact" description="Get in touch with Preserve Cayucos.">
  <section class="section">
    <div class="wrap contact">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Get in touch.</h1>
        <p class="intro">A concern about a project, a question about a county decision, or a skill you'd like to offer. We read everything.</p>
        <dl>
          <dt>Email</dt><dd><a href={`mailto:${c.email}`}>{c.email}</a></dd>
          <dt>Phone</dt><dd>{c.phone}</dd>
          <dt>Mail</dt><dd set:html={c.mailing.replace(/\n/g, '<br />')} />
        </dl>
      </div>
      <form
        name="contact"
        method="POST"
        action="/thanks/?f=contact"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="panel"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden"><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="field">
          <label for="c-name">Name</label>
          <input id="c-name" name="name" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="c-email">Email</label>
          <input id="c-email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="c-msg">Message</label>
          <textarea id="c-msg" name="message" required></textarea>
        </div>
        <div class="field check">
          <label><input type="checkbox" name="join_list" value="yes" /> Add me to the email list too</label>
        </div>
        <button type="submit" class="btn btn-primary">Send message</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 880px) { .contact { grid-template-columns: 1fr 1.1fr; gap: 5rem; } }
  .intro { font-size: 1.2rem; color: var(--muted); max-width: 30rem; }
  dl { margin: 2rem 0 0; display: grid; grid-template-columns: auto 1fr; gap: 0.6rem 1.25rem; }
  dt { font-weight: 600; font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); padding-top: 0.2rem; }
  dd { margin: 0; }
  .panel { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.75rem; }
  .check label { font-weight: 400; display: flex; gap: 0.6rem; align-items: center; }
  .check input { width: auto; }
</style>
