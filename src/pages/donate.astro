---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const d = site.donate;
---
<Base title="Donate" description="Support Preserve Cayucos.">
  <section class="section">
    <div class="wrap donate">
      <div>
        <p class="eyebrow">Donate</p>
        <h1>Help us stand up for Cayucos.</h1>
        <p class="intro">{d.intro}</p>
        <a href={d.url} class="btn btn-primary big" target="_blank" rel="noopener">Give online</a>
        <p class="note">Opens our secure donation page on PledgeIt.</p>
      </div>
      <aside class="panel">
        <h2>Where your gift goes</h2>
        <ul>
          {d.uses.map((u) => <li>{u}</li>)}
        </ul>
        {d.by_mail && (
          <>
            <h3>Giving by check</h3>
            <p set:html={d.by_mail.replace(/\n/g, '<br />')} />
          </>
        )}
        <p class="sponsor">{d.sponsor_statement}</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .donate { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 880px) { .donate { grid-template-columns: 1.3fr 1fr; gap: 5rem; } }
  .intro { font-size: 1.2rem; color: var(--muted); max-width: 34rem; margin-bottom: 2rem; }
  .big { font-size: 1.15rem; padding: 1em 2em; }
  .note { font-size: 0.88rem; color: var(--muted); margin-top: 0.75rem; }
  .panel { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.75rem; }
  .panel h2 { font-size: 1.4rem; }
  .panel ul { padding-left: 1.2em; margin: 0 0 1.5rem; }
  .panel li { margin-bottom: 0.4rem; }
  .sponsor { font-size: 0.9rem; color: var(--muted); border-top: 1px solid var(--line); padding-top: 1rem; margin: 0; }
</style>
